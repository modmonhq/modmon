{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/modmonhq/modmon/blob/master/packaging/release/manifest.schema.json",
  "title": "mm stable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "channel",
    "version",
    "tag",
    "commit",
    "published_at",
    "source_date_epoch",
    "minimum_installer_schema",
    "artifacts",
    "source",
    "sbom",
    "release_certificate",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "mm" },
    "channel": { "const": "stable" },
    "version": { "$ref": "#/$defs/version" },
    "tag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "published_at": { "type": "string", "format": "date-time" },
    "source_date_epoch": { "type": "integer", "minimum": 1 },
    "minimum_installer_schema": { "const": 1 },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "x86_64-unknown-linux-gnu",
          "aarch64-unknown-linux-gnu",
          "x86_64-apple-darwin",
          "aarch64-apple-darwin",
          "x86_64-pc-windows-msvc",
          "aarch64-pc-windows-msvc"
        ]
      },
      "additionalProperties": { "$ref": "#/$defs/artifact" }
    },
    "source": { "$ref": "#/$defs/file" },
    "sbom": { "$ref": "#/$defs/file" },
    "release_certificate": { "$ref": "#/$defs/file" },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "path": {
      "type": "string",
      "pattern": "^releases/v[0-9]+\\.[0-9]+\\.[0-9]+/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "sha256", "size", "binaries"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "format": { "enum": ["tar.gz", "zip"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "binaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["mm", "mmd", "mm-ingress-helper"] },
          "contains": { "const": "mm" }
        }
      }
    }
  }
}
