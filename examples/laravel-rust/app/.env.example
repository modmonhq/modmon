APP_NAME="Example Store"
APP_ENV=local # mm:from=APP.ENV required
APP_KEY= # mm:from=LARAVEL.APP.KEY required
APP_DEBUG=false # mm:from=APP.DEBUG required
APP_URL= # mm:from=APP.URL required
APP_ROLE=web
LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_DRIVER=cookie

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=preview@laravel-rust.test
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_URL=https://mail.mm.test

DB_CONNECTION=pgsql
DB_HOST=postgres # mm:from=DB.HOST required
DB_PORT=5432 # mm:from=DB.PORT required
DB_DATABASE=application # mm:from=DB.NAME required
DB_USERNAME=application # mm:from=DB.USER required
DB_PASSWORD= # mm:from=DB.PASSWORD required

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=valkey # mm:from=VALKEY.HOST required
REDIS_PORT=6379 # mm:from=VALKEY.PORT required

PRICING_SERVICE_URL=http://pricing:8080 # mm:from=PRICING.INTERNAL.URL required
