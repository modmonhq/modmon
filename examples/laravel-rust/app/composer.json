{
  "name": "example/laravel-rust-app",
  "description": "Minimal Laravel application for the mm portable deployment example.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
