{
  "name": "mm-local-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "generate:api": "node scripts/generate-api.mjs",
    "unit": "vitest run src/api.test.ts src/format.test.ts",
    "component": "vitest run src/components src/App.test.ts",
    "accessibility": "vitest run src/accessibility.test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "browser": "playwright test",
    "build": "vite build && node scripts/copy-gate-assets.mjs"
  },
  "dependencies": {
    "@cap.js/wasm": "0.0.7",
    "@cap.js/widget": "0.1.57",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "pako": "2.1.0",
    "reka-ui": "2.10.3",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/user-event": "14.6.6",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.10.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "axe-core": "4.13.0",
    "eslint": "10.9.0",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "15.0.4",
    "type-fest": "5.4.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
