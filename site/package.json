{
  "name": "mm-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 4317",
    "generate": "nuxt generate",
    "typecheck": "nuxt typecheck",
    "lint": "prettier --check nuxt.config.ts content.config.ts app ../packages/ui/src",
    "format": "prettier --write nuxt.config.ts content.config.ts app ../packages/ui/src",
    "check:links": "node ../scripts/check-links.mjs",
    "test:checks": "node ../scripts/test-doc-checks.mjs",
    "check:snippets": "node ../scripts/check-doc-snippets.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:links && npm run test:checks && npm run check:snippets",
    "check:a11y": "html-validate '.output/public/**/*.html'",
    "build": "nuxt generate && node ../scripts/check-built-links.mjs .output/public && npm run check:a11y && ../scripts/check-public-content.sh --source-tree .output/public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@nuxt/content": "3.16.2",
    "minisearch": "7.2.0",
    "nuxt": "4.6.4",
    "reka-ui": "2.11.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "html-validate": "11.21.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  }
}
