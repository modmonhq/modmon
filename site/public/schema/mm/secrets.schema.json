{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mm configuration: secrets",
  "type": "object",
  "$comment": "The value of top-level 'secrets', for .config/mm/secrets.yaml. Generated from MmConfig; run ./scripts/generate-artifacts.sh. Do not edit.",
  "additionalProperties": {
    "$ref": "#/$defs/SecretDeclaration"
  },
  "default": {},
  "$defs": {
    "SecretDeclaration": {
      "type": "object",
      "properties": {
        "generate": {
          "description": "Present for generated secrets created by `mm secret generate`. Omit for operator-supplied values.",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretGeneratorConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "description": "Hidden-input prompt for operator-supplied secrets set with `mm secret set` or `mm secret rotate`.",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretInputConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "rotation": {
          "$ref": "#/$defs/SecretRotationConfig",
          "default": {
            "strategy": "manual"
          }
        },
        "storage": {
          "$ref": "#/$defs/SecretStorageConfig"
        }
      },
      "additionalProperties": false,
      "required": [
        "storage"
      ]
    },
    "SecretEncoding": {
      "type": "string",
      "enum": [
        "base64",
        "base64-url",
        "hex"
      ]
    },
    "SecretGeneratorConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "length": {
              "type": "integer",
              "format": "uint",
              "default": 32,
              "minimum": 0
            },
            "preset": {
              "type": "string",
              "const": "password"
            }
          },
          "additionalProperties": false,
          "required": [
            "preset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "length": {
              "type": "integer",
              "format": "uint",
              "default": 48,
              "minimum": 0
            },
            "preset": {
              "type": "string",
              "const": "token"
            }
          },
          "additionalProperties": false,
          "required": [
            "preset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "encoding": {
              "$ref": "#/$defs/SecretEncoding",
              "default": "base64-url"
            },
            "length": {
              "type": "integer",
              "format": "uint",
              "default": 32,
              "minimum": 0
            },
            "preset": {
              "type": "string",
              "const": "bytes"
            }
          },
          "additionalProperties": false,
          "required": [
            "preset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "laravel-app-key"
            }
          },
          "additionalProperties": false,
          "required": [
            "preset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "uuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "preset"
          ]
        }
      ]
    },
    "SecretInputConfig": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt"
      ]
    },
    "SecretRotationConfig": {
      "type": "object",
      "properties": {
        "interval-days": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "strategy": {
          "$ref": "#/$defs/SecretRotationStrategy",
          "default": "manual"
        }
      },
      "additionalProperties": false
    },
    "SecretRotationStrategy": {
      "type": "string",
      "enum": [
        "manual",
        "replace-and-redeploy",
        "coordinated"
      ]
    },
    "SecretStorageConfig": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/StorageProviderId"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "location"
      ]
    },
    "StorageProviderId": {
      "type": "string"
    }
  }
}
