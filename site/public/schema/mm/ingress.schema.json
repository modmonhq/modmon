{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mm configuration: ingress",
  "$comment": "The value of top-level 'ingress', for .config/mm/ingress.yaml. Generated from MmConfig; run ./scripts/generate-artifacts.sh. Do not edit.",
  "$ref": "#/$defs/ProjectIngressConfig",
  "$defs": {
    "MiddlewareBundleConfig": {
      "type": "object",
      "properties": {
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file"
      ]
    },
    "ProjectIngressConfig": {
      "type": "object",
      "properties": {
        "automatic-local": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "middlewares": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/MiddlewareBundleConfig"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
