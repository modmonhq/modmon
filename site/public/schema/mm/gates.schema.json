{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mm configuration: gates",
  "type": "object",
  "$comment": "The value of top-level 'gates', for .config/mm/gates.yaml. Generated from MmConfig; run ./scripts/generate-artifacts.sh. Do not edit.",
  "additionalProperties": {
    "$ref": "#/$defs/GateConfig"
  },
  "$defs": {
    "GateConfig": {
      "type": "object",
      "properties": {
        "ingress": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider"
      ]
    }
  }
}
